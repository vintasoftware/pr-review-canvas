#!/bin/sh
set -eu

# The main worktree holds the local installation shared by linked worktrees.
common_dir=$(git rev-parse --git-common-dir)
common_dir=$(CDPATH= cd "$common_dir" && pwd -P)
primary=$(dirname "$common_dir")
current=$(git rev-parse --show-toplevel)
[ "$current" != "$primary" ] || exit 0
[ -d "$primary/.git" ] || exit 0

for source in \
	"$primary"/.agents/skills/* \
	"$primary"/.claude/skills/* \
	"$primary"/.codex/skills/* \
	"$primary"/.github/skills/* \
	"$primary"/.claude/agents/impeccable-*.md \
	"$primary/.claude/settings.local.json" \
	"$primary/.codex/hooks.json" \
	"$primary"/.github/agents/impeccable-*.agent.md \
	"$primary/.github/hooks/impeccable.json"
do
	[ -e "$source" ] || continue
	relative=${source#"$primary/"}
	destination="$current/$relative"
	# Preserve worktree-specific installations and settings, including symlinks.
	[ ! -e "$destination" ] && [ ! -L "$destination" ] || continue
	mkdir -p "$(dirname "$destination")"
	ln -s "$source" "$destination"
done
