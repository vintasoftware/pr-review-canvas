# Copy to viewer/.env.local (gitignored) to sign in with GitHub while running `pnpm viewer:dev`.
# Register a GitHub App with the callback URL http://127.0.0.1:4174/ (see viewer/README.md).

# The app's Client ID from its settings page (it starts with "Iv"), not the numeric App ID.
VITE_GITHUB_CLIENT_ID=
# The auth Worker. The dev server runs one at /__auth when GITHUB_CLIENT_SECRET is set below.
VITE_AUTH_WORKER_URL=http://127.0.0.1:4174/__auth
# The app's slug, from https://github.com/apps/<slug>, to link its install page. Optional.
VITE_GITHUB_APP_SLUG=

# The app's client secret, for the dev server's Worker only. Never prefix it with VITE_: those
# names are built into the page.
GITHUB_CLIENT_SECRET=
